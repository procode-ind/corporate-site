---
const title = 'Page not found · ProCode Ind';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Ubuntu:ital,wght@0,400;0,500;0,700;1,400;1,500&family=Ubuntu+Mono:wght@400;700&family=Ubuntu+Sans:wght@400;500;600&display=swap"
    />
    <link rel="stylesheet" href="/assets/site.css" />
  </head>
  <body>
    <header class="top">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label="ProCode Ind, home">
          <span class="brand-head" id="brand-head" aria-hidden="true">
            <span class="layer lines"></span><span class="layer crest"></span><span
              class="layer eye"></span>
          </span>
          <span class="brand-name">PI</span>
        </a>
      </div>
    </header>
    <main>
      <section class="hero">
        <div class="wrap" style="padding-block:96px 0;display:flex;flex-direction:column;gap:24px">
          <span class="label"><i>~</i>$ cd this-page</span>
          <h1 style="font-size:clamp(2rem,4.5vw,3.4rem);line-height:1.1">
            No such file or directory.
          </h1>
          <p class="lede">The page you are looking for does not exist or has moved.</p>
          <div class="row"><a class="btn primary" href="/">Go to the home page</a></div>
          <div class="hero-art" aria-hidden="true" style="margin-top:24px">
            <div class="iguana" id="iguana">
              <div class="part body">
                <span class="layer lines"></span><span class="layer crest"></span>
              </div>
              <div class="part tail">
                <div class="part tail-base">
                  <span class="layer lines"></span><span class="layer crest"></span>
                </div>
                <div class="part tail-tip">
                  <span class="layer lines"></span><span class="layer crest"></span>
                </div>
              </div>
              <div class="part head">
                <span class="layer lines"></span><span class="layer crest"></span><span
                  class="layer eye"></span>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
    <script is:inline src="/assets/site.js"></script>
  </body>
</html>
